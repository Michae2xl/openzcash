{
  "name": "openzcash",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "predev": "node --import tsx scripts/generate-navigation-icons.tsx && node scripts/publish-copilot.mjs && node scripts/build-zarvis-knowledge.mjs",
    "dev": "next dev",
    "prebuild": "node --import tsx scripts/generate-navigation-icons.tsx && node scripts/publish-copilot.mjs && node scripts/build-zarvis-knowledge.mjs && npm run errors:check && npm run check:proposal-cards && npm run wallets:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/build-zarvis-knowledge.test.mjs && node --test ops/error-fallback/handler.test.mjs && npm run errors:check && npm run test:ecosystem-sync",
    "test:watch": "vitest",
    "test:copilot": "node --test scripts/publish-copilot.test.mjs && python3 -B -m unittest discover -s skills/zcg-copilot/tests",
    "probe": "tsx scripts/probe-node.ts",
    "treasury:sync": "node --import tsx scripts/sync-openzcash-treasury.ts",
    "treasury:runtime": "node --import tsx scripts/treasury-runtime.ts",
    "import-zcg": "node --conditions=react-server --import tsx scripts/import-zcg.ts",
    "sync-ecosystem": "node scripts/sync-ecosystem.mjs",
    "audit:ecosystem": "tsx scripts/audit-ecosystem.ts",
    "test:ecosystem-sync": "node --test scripts/lib/ecosystem-collection.test.mjs scripts/lib/ecosystem-sync.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "knowledge:build": "node scripts/build-zarvis-knowledge.mjs",
    "knowledge:check": "node scripts/build-zarvis-knowledge.mjs --check",
    "test:knowledge": "node --test scripts/build-zarvis-knowledge.test.mjs",
    "knowledge:sync": "npm run knowledge:sync:zips && python3 scripts/sync-zarvis-references.py && python3 scripts/sync-zarvis-sources.py",
    "knowledge:sync:sources": "python3 scripts/sync-zarvis-sources.py",
    "eval:zarvis": "vitest run src/lib/zarvis/evaluation.test.ts src/lib/zarvis/narratives.test.ts",
    "zarvis:review": "bash scripts/zarvis-review.sh",
    "knowledge:sync:zips": "node --import tsx scripts/sync-zarvis-zips.ts",
    "errors:build": "tsx scripts/build-error-fallback.tsx",
    "errors:check": "tsx scripts/build-error-fallback.tsx --check",
    "test:errors": "vitest run src/components/errors/error-state.test.tsx && node --test ops/error-fallback/handler.test.mjs && npm run errors:check",
    "check:proposal-cards": "node scripts/check-proposal-cards.mjs",
    "check:crosslink": "node scripts/check-crosslink-sources.mjs",
    "check:crosslink:report": "node scripts/check-crosslink-sources.mjs --report",
    "test:funding-days": "node --test scripts/lib/funding-days-guard.test.mjs",
    "test:crosslink-sources": "node --test scripts/lib/crosslink-sources.test.mjs",
    "wallets:check": "tsx scripts/validate-wallet-evidence.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@simplewebauthn/browser": "14.0.0",
    "@types/three": "^0.185.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "libsodium-wrappers": "^0.8.4",
    "mdast-util-from-markdown": "2.0.3",
    "next": "16.4.2",
    "openai": "7.23.0",
    "parse5": "7.3.0",
    "postgres": "^3.4.9",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0",
    "tsx": "^4.22.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.12.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "26.1.0",
    "simple-icons": "^16.37.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "vite": "8.3.5"
  }
}
