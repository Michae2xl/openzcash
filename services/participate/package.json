{
  "name": "@openzcash/participate",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "sh -c 'prisma db push ${PRISMA_DB_PUSH_FLAGS:-}'",
    "db:seed": "tsx prisma/seed.ts",
    "collector:tally": "tsx scripts/collector-tally.ts",
    "participate:worker": "tsx scripts/participate-automation.ts run",
    "participate:worker:status": "tsx scripts/participate-automation.ts status",
    "participate:worker:logs": "tsx scripts/participate-automation.ts logs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:runtime": "node --test deploy/participate-web-runtime.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/setup-database.mjs",
    "build:verifiers": "node scripts/build-archive-verifiers.mjs && node scripts/build-decision-verifier.mjs",
    "prebuild": "npm run build:verifiers"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "resend": "6.32.1",
    "sharp": "0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.25.1",
    "eslint-config-next": "16.4.2",
    "jsdom": "^26.1.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "24.22.1"
  },
  "license": "Apache-2.0",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
